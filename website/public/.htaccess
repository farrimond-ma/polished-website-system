# Polished Insurance website (polished-insurance.co.uk) — static React build on SiteGround.
# Based on the Boxx Finance site's .htaccess. No PHP runs on this site: forms post to
# crm.polished-insurance.co.uk.

<FilesMatch "\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # The questionnaire link carries a private token — keep those pages out of search engines.
  <If "%{REQUEST_URI} =~ m#^/(insurance-questionnaire|get-a-quote/thank-you)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

Options -Indexes -MultiViews
<IfModule mod_dir.c>
  DirectorySlash Off
  # The static build's index.html always wins (the SiteGround folder may still hold an old index.php)
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── URLs from the previous site (Next.js on Vercel, live until 2026-09) ─────────────
  # Redirected straight to the canonical https://www host in ONE hop, so Google transfers
  # the existing rankings to the new pages. Full record: docs/co-uk-migration.md
  RewriteRule ^insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance [R=301,L]
  RewriteRule ^insurance/carpet-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/carpet-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/upholstery-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/carpet-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/domestic-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/domestic-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/contract-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/contract-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/end-of-tenancy-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/end-of-tenancy-cleaning-insurance [R=301,L]
  RewriteRule ^insurance/office-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/commercial-cleaning-insurance [R=301,L]
  RewriteRule ^insurance/window-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/window-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/oven-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/oven-cleaners-insurance [R=301,L]
  RewriteRule ^insurance/driveway-cleaners-insurance/?$ https://www.polished-insurance.co.uk/cleaning-insurance/pressure-washing-insurance [R=301,L]
  RewriteRule ^contact/?$ https://www.polished-insurance.co.uk/get-a-quote [R=301,L]
  RewriteRule ^blog/?$ https://www.polished-insurance.co.uk/guides [R=301,L]
  RewriteRule ^blog/([a-z0-9-]+)/?$ https://www.polished-insurance.co.uk/guides/$1 [R=301,L]

  # HTTPS + www canonical host
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.polished-insurance.co.uk/$1 [R=301,L]

  # (THE_REQUEST check: only the visitor's original request, never our own internal rewrite to index.html)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  # One page = one URL: strip .html and trailing slashes
  RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/[^?\s]+/[\s?]
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve prerendered pages (dir/index.html) at the clean URL
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Everything else: real files as-is. Every page is prerendered (including the noindex quote,
  # thank-you and questionnaire pages), so an unknown URL is a genuine 404 — never the app shell
  # with a 200, which search engines treat as a "soft 404".
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404.html
